<?xml version="1.0" encoding="utf-8"?>
<!--
  NAI PaintBrush MSIX manifest.

  Publisher MUST equal the product leaf subject exactly:
    CN=NAI PaintBrush, O=NANOTRIK.AI, C=US
  and the package is signed with that leaf (scripts/pb-build-msix.ps1).

  The executable is a VLC-engine Win32 binary in full-trust desktop mode.
  File/registry write virtualization is disabled because the editor owns
  %APPDATA%\vlc (engine config/plugin cache) and the user's Pictures folder,
  and its documents are ordinary files the user opens/saves.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap uap3 uap10 desktop6 rescap virtualization"
>
  <Identity
    Name="NAI.NAIPaintBrush"
    Publisher="CN=NAI PaintBrush, O=NANOTRIK.AI, C=US"
    Version="{{version}}"
    ProcessorArchitecture="{{architecture}}"
  />

  <Properties>
    <DisplayName>NAI PaintBrush</DisplayName>
    <PublisherDisplayName>NAI PaintBrush by NANOTRIK.AI</PublisherDisplayName>
    <Description>AI-native paint and video workstation: paint with video, harvest real moments, compose living artwork.</Description>
    <Logo>Assets\StoreLogo.png</Logo>

    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on" />
    </uap10:PackageIntegrity>

    <!-- The editor writes the engine config under %APPDATA%\vlc and documents
         under the user's Pictures folder; a full-trust editor must own real
         files, not package-virtualized copies. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0"
    />
  </Dependencies>

  <Applications>
    <Application
      Id="App"
      Executable="nai-paintbrush.exe"
      EntryPoint="Windows.FullTrustApplication"
    >
      <uap3:VisualElements
        DisplayName="NAI PaintBrush"
        Description="Paint with video. Harvest real moments. Compose living artwork."
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent"
        AppListEntry="default"
        VisualGroup="NAI"
      />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
