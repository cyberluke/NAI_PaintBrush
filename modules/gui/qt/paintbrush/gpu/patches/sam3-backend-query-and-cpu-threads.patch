diff --git a/sam3.cpp b/sam3.cpp
index 4d91d8a..4ddcc85 100644
--- a/sam3.cpp
+++ b/sam3.cpp
@@ -3380,6 +3380,25 @@ sam3_model_type sam3_get_model_type(const sam3_model& model) {
     return model.hparams.model_type;
 }
 
+const char * sam3_backend_name(const sam3_model& model) {
+    return model.backend ? ggml_backend_name(model.backend) : "none";
+}
+
+bool sam3_backend_is_gpu(const sam3_model& model) {
+    const char * name = sam3_backend_name(model);
+    return name && (std::strstr(name, "CUDA") != nullptr ||
+                    std::strstr(name, "Vulkan") != nullptr ||
+                    std::strstr(name, "Metal") != nullptr ||
+                    std::strstr(name, "SYCL") != nullptr);
+}
+
+/* The CPU backend's tracking graphs are not safe with >1 worker in this
+ * fork (access violation on the second propagation). CUDA is unaffected.
+ * Keep the GPU tracking graphs at 4 threads and the CPU path at 1. */
+static int sam3_track_threads(const sam3_model& model) {
+    return sam3_backend_is_gpu(model) ? 4 : 1;
+}
+
